# Our settings on top of Honcho's defaults (all LLM work on OpenAI gpt-5.4-mini, embeddings text-embedding-3-small).
# up.sh writes this plus LLM_OPENAI_API_KEY into server/.env. The API listens on 127.0.0.1:8000 only.
AUTH_USE_AUTH=false
LOG_LEVEL=INFO
# pilot.py imports one village day at a time and waits for it: process work at once instead of batching up to 30 min
DERIVER_FLUSH_ENABLED=true
